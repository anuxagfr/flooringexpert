
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user has 'Administrator' role
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrator';
    }

    // Users: Allow users to read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Settings: Public read, Admin write
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catalogues: Public read (for website), Admin write (for dashboard)
    match /catalogues/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Downloads (Leads): Admin read, Public write (anyone can submit form)
    match /downloads/{document=**} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }    // Analytics: Public write (for tracking), Admin read (for dashboard)
      match /analytics/{document=**} {
        allow read: if isAdmin();
        allow write: if true;
      }
  
}
